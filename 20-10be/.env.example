PORT=5001
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
# Đặt thông tin quản trị riêng khi deploy. Admin được tạo ở lần chạy đầu.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h
# Bỏ trống hai biến Redis để chạy local với JSON trong ../database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Cloudinary nhận ảnh trực tiếp từ trình duyệt; API Secret chỉ đặt trong biến môi trường bí mật.
CLOUDINARY_CLOUD_NAME=s0kzdkda
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Chạy local có thể bỏ Cloudinary; ảnh khi đó nằm trong ../database/uploads.
# Vercel cần đủ ba biến Cloudinary ở trên để nhận ảnh.
# Mặc định lưu JSON local ở ../database; dữ liệu deploy dùng Upstash Redis.
# DATA_DIR=/app/data
# Chỉ bật khi đứng sau một reverse proxy đáng tin cậy.
TRUST_PROXY=false
